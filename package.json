{
  "name": "local-meta-harness",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "ui",
    "core"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names core,ui \"npm run dev --workspace core\" \"npm run dev --workspace ui\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint ui/src core/src ui/vite.config.ts eslint.config.mjs",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}

# Values belong in the ignored repository-root .env, not a second secret file.
MANUFACTURING_DB_PASSWORD=
MANUFACTURING_API_KEY=
MANUFACTURING_HOST_PORT=8100
MANUFACTURING_SEED=42
MANUFACTURING_SAMPLE_COUNT=1000
MANUFACTURING_REQUEST_TIMEOUT=30
MANUFACTURING_LOG_LEVEL=INFO
# Native settings (Docker supplies private networking values):
MANUFACTURING_DB_HOST=manufacturing-db
MANUFACTURING_DB_PORT=5432
MANUFACTURING_DB_NAME=manufacturing
MANUFACTURING_DB_USER=manufacturing
MANUFACTURING_ARTIFACT_DIR=/data/models
MANUFACTURING_PORT=8000
MANUFACTURING_MAX_DATASET_SIZE=50000
MANUFACTURING_MCP_ALLOWED_HOSTS=manufacturing-ml:8000,localhost:8000,127.0.0.1:8000,localhost:8100,127.0.0.1:8100

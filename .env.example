# Copy to the root .env only when no .env exists, then set a password.
# Run chmod 600 .env. Compose and native core use that same secret file.
# An initialized PostgreSQL volume requires its existing database password.
DB_PASSWORD=

# Store all future passwords, tokens, API keys, and confidential connection
# settings in .env. Keep confidential example values empty.
# Never use a VITE_ variable for confidential values: those reach the browser.
# See docs/OPERATIONS.md for environment loading and supported settings.

# OpenAI configuration: key stays empty in committed examples.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=
LLM_THINKING=medium
# Optional exact token capacity for the selected model (90% triggers compaction).
# Blank uses verified GPT-6 Luna/Astra/6.1 Sol capacities; other models use 128000.
LLM_CONTEXT_WINDOW_TOKENS=

# Standalone local RAG secrets; generated locally, never committed.
RAG_DB_PASSWORD=
RAG_API_KEY=
# Optional generic MCP bearer credentials are referenced by variable name.
MCP_EXAMPLE_TOKEN=
# Independent synthetic manufacturing demonstration; values remain empty here.
MANUFACTURING_DB_PASSWORD=
MANUFACTURING_API_KEY=
# General RAG defaults/complete settings: rag-server/.env.example and README.md.

# Non-secret exact origin allowlist for outgoing RAG REST/MCP connections.
# Custom origins must be added by the operator; redirects and metadata IPs are blocked.
RAG_ALLOWED_ORIGINS=http://rag-api:8090,http://rag:8090,http://localhost:8090,http://127.0.0.1:8090
MCP_ALLOWED_ORIGINS=http://rag-api:8090,http://rag:8090,http://localhost:8090,http://127.0.0.1:8090,http://manufacturing-ml:8000,http://localhost:8100,http://127.0.0.1:8100
# RAG UI writes MCP_TOKEN_<PROFILE_UUID_WITHOUT_HYPHENS>=<secret> to ignored .env.
# Do not add real tokens to this example.

# Durable tasks (no new database or service). Root .env only.
TASK_WORKER_ENABLED=true
TASK_CONCURRENCY=2
TASK_MAX_TURNS=8
TASK_MAX_TOKENS=200000
TASK_MAX_ACTIVE_MS=120000
# These turn/token/active-time limits apply to each automatically continued prompt.
TASK_MAX_CONTINUATIONS=20
TASK_MAX_RETRIES=5
# Optional native approved workspace; local commands disabled if empty.
TASK_WORKSPACE_ROOT=
# Comma-separated server UUID:tool entries always requiring exact approval.
TASK_DANGEROUS_MCP_TOOLS=

# Optional conservative cost estimate: set both to enforce a currency budget.
TASK_MAX_COST_USD=
TASK_TOKEN_COST_USD_PER_MILLION=

# Only operator-reviewed tools in this list may receive broad task grants.
# Unclassified MCP writes require exact approval, even if a server claims safety.
TASK_CONTROLLED_MCP_TOOLS=

# ZSK replacement: read-only and administrative MCP/API credentials
ZSK_API_KEY=
ZSK_ADMIN_API_KEY=
ZSK_DATABASE_VOLUME=manufacturing-demo_manufacturing-data

# Optional simulation-only factory. Separate scoped service credentials.
FACTORY_API_TOKEN=
FACTORY_MCP_AUTH_TOKEN=
TASK_INTEGRATION_TOKEN=
FACTORY_API_URL=http://factory:8110
FACTORY_ALLOWED_ORIGINS=http://factory:8110,http://127.0.0.1:8110
FACTORY_SERVER_ID=
FACTORY_RAG_SERVER_ID=
FACTORY_RAG_DEVICE_ID=
FACTORY_TASK_TEMPLATE=manufacturing-alert
ML_MONITOR_INTERVAL_MINUTES=10
SIMULATION_AUTO_STOP_ALLOWED=false
SIMULATION_AUTO_RESTART_ALLOWED=false
SIMULATION_AUTO_MAINTENANCE_ALLOWED=false
FACTORY_AUTOMATIC_FAULTS=true
ZSK_FORECAST_BOOTSTRAP=true
ZSK_FORECAST_HORIZON_MINUTES=30
# Add http://factory:8110 to MCP_ALLOWED_ORIGINS explicitly when registering.
FACTORY_TEST_DB_PASSWORD=

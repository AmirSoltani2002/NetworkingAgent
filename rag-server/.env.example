# Standalone project secrets. For this checkout keep these in ../.env and use
# docker compose --env-file ../.env. Never overwrite an existing secret file.
RAG_DB_PASSWORD=
RAG_API_KEY=
RAG_AUTH_REQUIRED=true
RAG_PORT=8090
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
RAG_EMBEDDING_DIMENSION=384
RAG_EMBEDDING_DEVICE=cpu
RAG_MODEL_OFFLINE=false
RAG_TORCH_THREADS=2
RAG_SEMANTIC_MIN_CHARS=700
RAG_SEMANTIC_BUFFER_SIZE=1
RAG_SEMANTIC_BREAKPOINT_PERCENTILE=90
RAG_MAX_CHUNK_TOKENS=220
RAG_RETRIEVAL_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.2
RAG_ISSUE_SIMILARITY_THRESHOLD=0.3
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RAG_LOGGING_LEVEL=INFO


# Native development defaults; Compose sets container hosts/paths.
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=rag
RAG_DB_USER=rag
RAG_STORAGE_DIR=./storage
RAG_MODEL_CACHE_DIR=./model-cache
RAG_EMBEDDING_BATCH_SIZE=16
RAG_MAX_UPLOAD_MB=25
RAG_MAX_EXTRACT_CHARS=5000000
RAG_MAX_PDF_PAGES=1000
RAG_MAX_CHUNKS=20000
RAG_CANDIDATE_COUNT=50
RAG_RRF_K=60
RAG_WORKER_POLL_SECONDS=2
RAG_WORKER_MAX_ATTEMPTS=3
RAG_WORKER_RETRY_SECONDS=10
RAG_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,rag:*,rag-api:*

# Compose connection host; native development uses RAG_DB_HOST above.
RAG_DB_HOST_DOCKER=database
